# Copier en .env.local et remplir. Ce fichier ne contient que des valeurs
# FICTIVES : n'y mettre jamais une vraie clé, il est suivi par git.
#
# Les variables NEXT_PUBLIC_* sont embarquées dans le bundle envoyé au
# navigateur : tout le monde peut les lire. Toutes les autres restent
# côté serveur uniquement.

# ── Indispensables — sans elles l'application ne démarre pas ─────────────────
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...cle-anon-publique
# SERVEUR UNIQUEMENT. Contourne RLS : quiconque l'obtient lit et écrit toute
# la base. Ne jamais la préfixer NEXT_PUBLIC_, ne jamais la commiter.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...cle-de-service

# ── Par fonctionnalité — l'app démarre sans, la fonction est hors service ────

# OCR des factures fournisseurs et des justificatifs (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Envoi des offres et factures par e-mail (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=facturation@exemple.ch
MAIL_BCC=copie@exemple.ch

# Fichiers sur kDrive Infomaniak (pièces de projet, dossiers comptables)
KDRIVE_TOKEN=xxxxxxxxxxxxxxxxxxxx
KDRIVE_DRIVE_ID=0000000
# Optionnel : sépare la clé de signature des jetons d'accès kDrive de la clé de
# service. Sans elle, elle en est dérivée — ce qui convient.
KDRIVE_TOKEN_SECRET=

# Authentifie les crons Vercel (facturation de stockage, notifications, Odoo).
# Une chaîne aléatoire longue : openssl rand -hex 32
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Synchronisation des tâches
TODOIST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
TODOIST_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Synchro clients Odoo (hors service : clés à renouveler)
ODOO_URL=https://exemple.odoo.com
ODOO_DB=exemple
ODOO_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Notifications push (générer la paire : npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# Autocomplétion d'adresses (repli sur Nominatim si absente)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=xxxxxxxxxxxxxxxxxxxx
# Google Agenda sur la page Accueil
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Chemin de Chrome en local pour générer les PDF (sur Vercel : @sparticuz/chromium)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── Coordonnées imprimées sur les offres, factures et QR-bills ───────────────
# Servent de valeurs par défaut ; les réglages en base (app_settings.company_info,
# modifiables par l'admin dans /settings) ont la priorité.
AMAZING_LAB_NAME=amazing lab switzerland sàrl
AMAZING_LAB_ADDRESS=Avenue de la Gare 48
AMAZING_LAB_ZIP=1022
AMAZING_LAB_CITY=Chavannes-Près-Renens
AMAZING_LAB_COUNTRY=CH
AMAZING_LAB_IBAN=CH00 0000 0000 0000 0000 0
AMAZING_LAB_VAT=CHE-000.000.000
AMAZING_LAB_EMAIL=hello@exemple.ch
AMAZING_LAB_PHONE=+41 00 000 00 00
AMAZING_LAB_WEBSITE=exemple.ch
